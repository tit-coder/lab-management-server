# Cau hinh ket noi MariaDB Database (su dung user phan quyen rieng, khong dung root)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lab_management
DB_USER=labapp
DB_PASSWORD=your_secure_password_here

# Cau hinh Web Server C++
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
