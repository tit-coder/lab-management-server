# Server HTTP Service Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# MariaDB / Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lab_management
DB_USER=lab_user
DB_PASSWORD=lab_password_change_me
